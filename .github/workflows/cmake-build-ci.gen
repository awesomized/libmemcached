  ],
  "mingw" => [
    "CMAKE_GENERATOR" => "MinGW Makefiles"
  ]
];
const MAP = [
  "Linux" => [
    'env.OS_VER' => [
      "ubuntu-22.04" => [
        'env.CC_VND' => [
          "gnu" => [
            'env.CC_VER' => [
              "new"  => "-12",
              "cur"  => "-11",
              "old"  => "-10",
            ]
          ],
          "clang" => [
            'env.CC_VER' => [
              "new"  => "-15",
