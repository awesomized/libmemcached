];
const ENV = [
  "ubuntu-22.04" => [
    "clang" => [
      "new" => [
        "CXXFLAGS" => "-stdlib=libc++",
        "INSTALL_CXX" => "libc++-15-dev libc++abi-15-dev"
      ],
      "cur" => [
